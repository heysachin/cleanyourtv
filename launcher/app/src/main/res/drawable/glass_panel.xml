<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: deep dark frosted glass with tvOS dark vibrancy -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315"
                android:startColor="#F214151F"
                android:centerColor="#EA191B26"
                android:endColor="#E2101118" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Top specular glass highlight -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="#1FFFFFFF"
                android:centerColor="#05FFFFFF"
                android:endColor="#00000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Sleek border: luminous glassy outline -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
