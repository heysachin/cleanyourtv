<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_marginBottom="6dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/dialog_option_focus_bg">

    <ImageView
        android:id="@+id/optionIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:tint="#E6FFFFFF"
        android:layout_marginEnd="16dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/optionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="-0.005" />

        <TextView
            android:id="@+id/optionDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#8CFFFFFF"
            android:textSize="11.5sp"
            android:fontFamily="@font/outfit_regular"
            android:letterSpacing="0.01" />
    </LinearLayout>

    <TextView
        android:id="@+id/optionArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="#4DFFFFFF"
        android:textSize="22sp"
        android:fontFamily="@font/outfit_light"
        android:layout_marginStart="10dp" />
</LinearLayout>
